{
  "name": "rea-cli",
  "version": "2.0.0",
  "description": "CLI for the REA (Reverse Engineer Anything) MCP tool catalog",
  "main": "dist/main.js",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rea": "bin/rea.mjs"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.9",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "catalog:refresh": "node scripts/refresh-catalog.mjs"
  },
  "keywords": [
    "cli",
    "mcp",
    "rea",
    "reverse-engineering"
  ]
}
