# REA MCP server launch configuration
# Defaults to: npx -y rea-agents@latest --mcp
# REA_COMMAND=npx
# REA_ARGS=-y rea-agents@latest --mcp
# REA_CWD=C:\tools\rea

# Timeouts
# REA_MCP_TIMEOUT_MS=120000
# REA_CALL_TIMEOUT_MS=300000

# Filesystem roots the CLI may access (comma-separated absolute paths).
# Empty = no restriction.
# REA_ALLOW_OPEN_BINARY_PATHS=C:\targets,D:\samples

# debug | info | warn | error
# LOG_LEVEL=warn
